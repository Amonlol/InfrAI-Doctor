# If true, then run all emulators (AWS, Azure, GCP, OCI), else run only AWS
# currently supported and tested only AWS
RUN_ALL=false

# If true, then use named volume for floci /app/data
PERSISTENCE=false
COMPOSE_FILE=docker-compose.yml

# Floci settings
FLOCI_ENDPOINT=http://floci:4566
FLOCI_STORAGE_MODE=persistent

# Floci-ui settings
API_TARGET=http://floci-api:4500
PORT=4500
VITE_USE_POLLING=true

# AWS settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# If RUN_ALL=true

# Azure
FLOCI_AZURE_ENDPOINT=http://floci-az:4577
FLOCI_AZURE_ACCOUNT_NAME=devstoreaccount1

# GCP
FLOCI_GCP_ENDPOINT=http://floci-gcp:4588
FLOCI_GCP_PROJECT=floci-local

# OCI
FLOCI_OCI_ENDPOINT=http://floci-oci:4599
FLOCI_OCI_SERVICES_FUNCTIONS_MOCK=true
FLOCI_OCI_SERVICES_OKE_MOCK=true
